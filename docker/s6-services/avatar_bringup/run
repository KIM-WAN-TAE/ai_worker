#!/command/with-contenv bash
# Avatar Bringup - selectable Leader AI service
# Uses reusable ROS2 service template

set -e

SERVICE_NAME="avatar_bringup"
LEADER_TYPE_FILE="/run/leader_type"
LEADER_TYPE="a3"
if [ -f "${LEADER_TYPE_FILE}" ]; then
    LEADER_TYPE=$(tr -d '[:space:]' < "${LEADER_TYPE_FILE}" | tr '[:upper:]' '[:lower:]')
fi
if [ "${LEADER_TYPE}" = "a3" ]; then
    # The trigger establishes a no-command baseline from the first valid
    # gripper sample, then requires a fresh above-to-below threshold crossing.
    # This keeps the save-pose shortcut without the former startup edge.
    ROS2_COMMAND="ros2 launch ffw_bringup ffw_a3_ai.launch.py launch_gripper_trigger:=true"
elif [ "${LEADER_TYPE}" = "mini" ]; then
    ROS2_COMMAND="ros2 launch ffw_bringup ffw_lg2_mini_leader_ai.launch.py"
elif [ "${LEADER_TYPE}" = "a2" ]; then
    ROS2_COMMAND="ros2 launch ffw_bringup ffw_a2_ai.launch.py"
elif [ "${LEADER_TYPE}" = "lg2" ]; then
    ROS2_COMMAND="ros2 launch ffw_bringup ffw_lg2_leader_ai.launch.py"
else
    echo "[${SERVICE_NAME}] Error: unsupported leader type '${LEADER_TYPE}' (supported: a3, mini, a2, lg2)" >&2
    exit 1
fi
COMMON_SCRIPT="/usr/local/lib/s6-services/ros2_service_run.sh"

if [ -f "${COMMON_SCRIPT}" ]; then
    export SERVICE_NAME="${SERVICE_NAME}"
    export ROS2_COMMAND="${ROS2_COMMAND}"
    exec /command/with-contenv env SERVICE_NAME="${SERVICE_NAME}" ROS2_COMMAND="${ROS2_COMMAND}" bash -i -c "${COMMON_SCRIPT}"
else
    echo "Error: Common script not found at ${COMMON_SCRIPT}" >&2
    exit 1
fi
